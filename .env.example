

# The live domain once ktbsolar.com (or whatever domain is chosen) is purchased.
# Used for canonical URLs, Open Graph tags, and structured data.
# Falls back to a safe placeholder if not set, so local dev still works.
VITE_SITE_URL=https://ktbsolar.com

# Google Analytics 4 Measurement ID (starts with G-). Leave blank to disable analytics.
VITE_GA_MEASUREMENT_ID=
